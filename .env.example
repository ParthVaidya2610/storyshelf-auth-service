# Copy to .env and fill with real values. Do not commit .env.
#
#   cp .env.example .env
#
# docker-compose reads .env automatically. To run outside Docker, export these
# in your shell or set them in the IntelliJ run configuration.

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Same Neon project/endpoint as bookstore-microservices, but a DEDICATED database
# so this service owns its own `users` table. Create it once with:
#
#   CREATE DATABASE authdb;
#
# (Neon console -> SQL Editor, or psql against neondb.)
#
# sslmode=require is mandatory — Neon refuses plaintext connections.
# If you switch to Neon's POOLED endpoint (host contains "-pooler"), also append
# &prepareThreshold=0 — PgBouncer in transaction mode breaks server-side prepared
# statements and you'll get "prepared statement S_1 already exists" errors.
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-delicate-hat-abydhm1l.eu-west-2.aws.neon.tech/authdb?sslmode=require&channel_binding=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=

# Schema management. The FIRST boot against an empty authdb needs `update` so
# Hibernate creates the users table; set it back to `validate` afterwards so the
# app can never silently alter the schema. Long term, replace this with Flyway.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Connection pool. Defaults suit Neon's scale-to-zero; raise the pool size only
# if you hit contention, and mind your Neon plan's connection limit.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=300000
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------
# Both auth cookies are httpOnly and Secure by default. Modern Chrome/Firefox do
# accept Secure cookies from http://localhost (it counts as a secure context), so
# leave this true if you can — flip to false only if your browser drops them.
# NEVER true=false anywhere reachable over a network: the tokens go out in clear.
COOKIE_SECURE=true

# Strict is safe for a frontend on a different PORT (SameSite ignores ports, so
# localhost:3001 -> localhost:8092 is same-site). If your frontend ever lives on a
# genuinely different registrable domain than the API, Strict will drop the cookie
# and you need Lax — or None, which then requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=

# Comma-separated. allowCredentials is on, so a wildcard is not permitted here.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# Login lockout
# ---------------------------------------------------------------------------
# Consecutive failures before the account locks, and how long the lock lasts
# (ISO-8601 duration). The lock clears itself once the window elapses.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=PT15M

# ---------------------------------------------------------------------------
# Legacy password migration
# ---------------------------------------------------------------------------
# Leave disabled. Re-encoding an already-hashed password cannot be undone, so this
# also defaults to a dry run even when enabled — check the log, then set
# PASSWORD_MIGRATION_DRY_RUN=false for one run, then turn it off again.
PASSWORD_MIGRATION_ENABLED=false
PASSWORD_MIGRATION_DRY_RUN=true

# ---------------------------------------------------------------------------
# JWT signing keys
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P7D

# NOT committed. docker-compose mounts ./docker/secrets into the container.
# Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out docker/secrets/jwt-private.pem
#   openssl rsa -pubout -in docker/secrets/jwt-private.pem -out docker/secrets/jwt-public.pem
JWT_PRIVATE_KEY_PATH=file:/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=file:/run/secrets/jwt-public.pem

# ---------------------------------------------------------------------------
# Local Postgres (optional)
# ---------------------------------------------------------------------------
# Only used by the `local-db` compose profile:
#   docker compose --profile local-db up
# Ignored entirely when pointing at Neon. If you do use it, you MUST also point
# SPRING_DATASOURCE_URL at the container hostname (not localhost) and drop the
# Neon SSL params, by uncommenting these three and commenting out the Neon block:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/auth_db
#   SPRING_DATASOURCE_USERNAME=postgres
#   SPRING_DATASOURCE_PASSWORD=<same as POSTGRES_PASSWORD below>
POSTGRES_HOST_PORT=5434
POSTGRES_DB=auth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
